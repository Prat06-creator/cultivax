{
  "data_dir": "dataset/images",
  "img_size": [
    224,
    224
  ],
  "batch_size": 16,
  "epochs": 100,
  "initial_lr": 0.0001,
  "finetune_lr": 1e-05,
  "finetune_unfreeze_layers": 60,
  "finetune_epochs": 50,
  "checkpoint_dir": "checkpoints",
  "plateau_rel_threshold": 0.01,
  "plateau_patience": 3,
  "lr_reduce_factor": 0.5,
  "overfit_patience": 3,
  "train_improve_threshold": 0.0,
  "monitor_metric": "val_loss"
}